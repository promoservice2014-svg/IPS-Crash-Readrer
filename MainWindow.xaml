<Window x:Class="IpsReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPS Reader" Icon="/Assets/app.ico" Height="840" Width="1300" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop"
        Background="#F3F4F6" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D4DA" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#E2E5EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="ReadOnlyText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CodeText" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyText}">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#F6F8FA" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="AppRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAppCode}" Value="True">
                    <Setter Property="Foreground" Value="#1A56DB" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Background" Value="#EEF4FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppImageRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsApp}" Value="True">
                    <Setter Property="Foreground" Value="#1A56DB" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Background" Value="#EEF4FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="ClipboardCopyMode" Value="ExcludeHeader" />
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" CanExecute="HasReport_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" CanExecute="HasReport_CanExecute" />
    </Window.CommandBindings>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E5EA" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Open" Content="📂  Open…" ToolTip="Open an .ips or .crash file (Ctrl+O)" />
                    <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Save" Content="💾  Export report" ToolTip="Save the report as text (Ctrl+S)" />
                    <Button x:Name="CopyButton" Style="{StaticResource ToolButton}" Click="CopyDiagnosis_Click" Content="📋  Copy diagnosis" IsEnabled="False" ToolTip="Copy the summary and diagnosis to the clipboard" />
                    <Button Style="{StaticResource ToolButton}" Click="Associate_Click" Content="🔗  Associate .ips files" ToolTip="Open .ips and .crash files with a double click" />
                </StackPanel>
                <TextBlock x:Name="FileLabel" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#6B7280" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E2E5EA" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock x:Name="StatusText" Foreground="#6B7280" FontSize="12" Text="Ready" />
        </Border>

        <Grid>
            <!-- Empty state -->
            <Border x:Name="DropZone" Margin="40" CornerRadius="12" BorderBrush="#B8C0CC" BorderThickness="2" Background="White">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📄" FontSize="56" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop an iOS crash report here" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text=".ips files (iOS 15+ and earlier) or .crash" Foreground="#6B7280" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Open" Content="Open file…" HorizontalAlignment="Center" Margin="0,18,0,0" Padding="20,8" />
                </StackPanel>
            </Border>

            <TabControl x:Name="Tabs" Visibility="Collapsed" Margin="12" Padding="0" Background="White">
                <!-- Summary -->
                <TabItem Header="Summary">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F3F4F6">
                        <StackPanel Margin="18" MaxWidth="1150">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="#6B7280" Margin="0,2,0,12" TextWrapping="Wrap" />
                                    <Border Background="{Binding HeadlineBackground}" CornerRadius="6" Padding="14,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Analysis.Category}" FontSize="11" FontWeight="Bold" Foreground="{Binding HeadlineColor}" />
                                            <TextBlock Text="{Binding Analysis.Headline}" FontSize="17" FontWeight="SemiBold" Foreground="{Binding HeadlineColor}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="Diagnosis" Margin="2,6,0,10" />
                            <ItemsControl ItemsSource="{Binding Analysis.Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" CornerRadius="8" BorderBrush="#E2E5EA" BorderThickness="1" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding Accent}" CornerRadius="8,0,0,8" />
                                                <StackPanel Grid.Column="1" Margin="16,12,16,14">
                                                    <TextBlock Text="{Binding LevelLabel}" FontSize="10" FontWeight="Bold" Foreground="{Binding Accent}" />
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,4" />
                                                    <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding Text, Mode=OneWay}" Visibility="{Binding HasText, Converter={StaticResource B2V}}" />
                                                    <TextBox Style="{StaticResource CodeText}" Text="{Binding Code, Mode=OneWay}" Margin="0,8,0,0" Visibility="{Binding HasCode, Converter={StaticResource B2V}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Card}" Visibility="{Binding HasStack, Converter={StaticResource B2V}}" Margin="0,4,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding StackTitle}" />
                                    <TextBox Style="{StaticResource CodeText}" Text="{Binding StackPreview, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Details" />
                                    <ItemsControl ItemsSource="{Binding Info}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,18,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" Foreground="#6B7280" />
                                                    <TextBox Grid.Column="1" Style="{StaticResource ReadOnlyText}" Text="{Binding Value, Mode=OneWay}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Threads -->
                <TabItem Header="{Binding ThreadsHeader}">
                    <Grid Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" MinWidth="180" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="ThreadList" ItemsSource="{Binding Threads}" BorderThickness="0,0,1,0" BorderBrush="#E2E5EA"
                                 SelectionChanged="ThreadList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" />
                                            <Border Background="{Binding BadgeColor}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasBadge, Converter={StaticResource B2V}}">
                                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplaySubtitle}" Foreground="#6B7280" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#F3F4F6" />

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Margin="12,10">
                                <CheckBox x:Name="AppOnlyCheck" DockPanel.Dock="Right" Content="App code only" VerticalAlignment="Center"
                                          Checked="AppOnly_Changed" Unchecked="AppOnly_Changed" />
                                <StackPanel>
                                    <TextBlock x:Name="ThreadTitle" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ThreadSubtitle" Foreground="#6B7280" FontSize="12" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="FramesGrid" Grid.Row="1" FontFamily="{StaticResource Mono}" FontSize="12" RowStyle="{StaticResource AppRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="42" />
                                    <DataGridTextColumn Header="Image" Binding="{Binding ImageName}" Width="220" />
                                    <DataGridTextColumn Header="Address" Binding="{Binding AddressHex}" Width="160" />
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding SymbolDisplay}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Expander x:Name="RegistersExpander" Grid.Row="2" Header="Registers" Margin="8,4,8,8">
                                <DataGrid x:Name="RegistersGrid" Height="220" FontFamily="{StaticResource Mono}" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Register" Binding="{Binding Name}" Width="90" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="180" />
                                        <DataGridTextColumn Header="Notes" Binding="{Binding Note}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Text report -->
                <TabItem x:Name="ReportTab" Header="Text Report">
                    <DockPanel Background="White">
                        <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="#E2E5EA" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="ReportFindBox" Width="280" Padding="4,2" KeyDown="FindBox_KeyDown" Tag="{Binding ElementName=ReportBox}" />
                                <Button Content="Find next" Padding="10,2" Margin="6,0,0,0" Click="FindNext_Click" Tag="{Binding ElementName=ReportFindBox}" />
                                <CheckBox x:Name="WrapCheck" Content="Word wrap" Margin="18,0,0,0" VerticalAlignment="Center" Checked="Wrap_Changed" Unchecked="Wrap_Changed" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="ReportBox" FontFamily="{StaticResource Mono}" FontSize="12" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="10" TextWrapping="NoWrap" />
                    </DockPanel>
                </TabItem>

                <!-- Binary images -->
                <TabItem Header="{Binding ImagesHeader}">
                    <DataGrid ItemsSource="{Binding Images}" FontFamily="{StaticResource Mono}" FontSize="12" RowStyle="{StaticResource AppImageRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="Start" Binding="{Binding BaseHex}" Width="130" />
                            <DataGridTextColumn Header="End" Binding="{Binding EndHex}" Width="130" />
                            <DataGridTextColumn Header="Arch" Binding="{Binding Arch}" Width="70" />
                            <DataGridTextColumn Header="UUID" Binding="{Binding Uuid}" Width="300" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- JSON -->
                <TabItem x:Name="JsonTab" Header="Raw JSON">
                    <DockPanel Background="White">
                        <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="#E2E5EA" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="JsonFindBox" Width="280" Padding="4,2" KeyDown="FindBox_KeyDown" Tag="{Binding ElementName=JsonBox}" />
                                <Button Content="Find next" Padding="10,2" Margin="6,0,0,0" Click="FindNext_Click" Tag="{Binding ElementName=JsonFindBox}" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="JsonBox" FontFamily="{StaticResource Mono}" FontSize="12" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="10" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
